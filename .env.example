# Development defaults only. Production values belong in a secret manager or
# root-owned environment file outside the repository.
WMS_DEBUG=true
WMS_SECRET_KEY=replace-for-production
WMS_ALLOWED_HOSTS=127.0.0.1,localhost

# Production PostgreSQL example
WMS_DB_ENGINE=sqlite
WMS_DB_NAME=db.sqlite3
# WMS_DB_USER=wms_app
# WMS_DB_PASSWORD=replace-me
# WMS_DB_HOST=database.internal
# WMS_DB_PORT=5432
# WMS_DB_SSLMODE=require
# WMS_DB_CONN_MAX_AGE=60

WMS_SESSION_COOKIE_SECURE=false
WMS_CSRF_COOKIE_SECURE=false
WMS_SECURE_SSL_REDIRECT=false
WMS_BEHIND_HTTPS_PROXY=false
WMS_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
WMS_SECURE_HSTS_SECONDS=0

# Quotation email (use the provider's app password/API SMTP credential).
WMS_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
WMS_EMAIL_HOST=smtp.example.com
WMS_EMAIL_PORT=587
WMS_EMAIL_HOST_USER=quotations@example.com
WMS_EMAIL_HOST_PASSWORD=replace-with-secret
WMS_EMAIL_USE_TLS=true
WMS_EMAIL_USE_SSL=false
WMS_EMAIL_TIMEOUT=20
WMS_DEFAULT_FROM_EMAIL=quotations@example.com

# Store this outside the repository and outside media.
WMS_BACKUP_ROOT=../wms_backups
WMS_BACKUP_RETENTION_DAYS=30
WMS_BACKUP_DATABASE_TIMEOUT=3600
