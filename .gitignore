__pycache__/
*.py[cod]
.Python
.venv/
venv/
.env
.env.*
!.env.example
node_modules/
staticfiles/
*.sqlite3
*.sqlite3-journal

# Runtime uploads belong in object storage/backups, not source control.
/media/*
!/media/.gitkeep

# Keep Django migration source files committed; only their caches are ignored.
**/migrations/__pycache__/

# Test, lint, coverage, and local runtime output.
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
*.log
/tmp/
/output/
/outputs/

# IDE and operating-system metadata.
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Generated frontend/mobile build output.
/cad_frontend/dist/
/mobile/dist-android/
/mobile/.expo/

# Local database-browser binaries are tooling, not application dependencies.
/*.dll
/DB Browser for SQLite.exe
/DB Browser for SQLCipher.exe
/bearer/
/extensions/
/imageformats/
/licenses/
/platforms/
/printsupport/
